# Default settings: follow the browser's system setting, show the header
# button. The service starts here, so the theme works right after install.

import agent

agent.set_env("DEFAULT_THEME", "system")
agent.set_env("SHOW_TOGGLE", "1")
agent.run_helper("systemctl", "--user", "enable", "--now", "theme.service").check_returncode()

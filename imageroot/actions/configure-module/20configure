import json
import sys

import agent

request = json.load(sys.stdin)

agent.set_env("DEFAULT_THEME", request["default_theme"])
if "show_toggle" in request:
    agent.set_env("SHOW_TOGGLE", "1" if request["show_toggle"] else "0")

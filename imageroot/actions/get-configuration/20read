import json
import os
import subprocess
import sys

import agent

active = subprocess.run(
    ["systemctl", "--user", "is-active", "--quiet", "theme.service"]
).returncode == 0

json.dump(
    {
        "default_theme": os.environ.get("DEFAULT_THEME", "system"),
        "show_toggle": os.environ.get("SHOW_TOGGLE", "1") != "0",
        "service_active": active,
    },
    fp=sys.stdout,
)
